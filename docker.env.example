# Application runtime
NODE_ENV=production

# Port inside the Docker container
PORT=3000

# Use 1 when there is exactly one trusted HTTP reverse proxy,
# such as Nginx, between the public internet and this container.
TRUST_PROXY=1

# Added when OpenAI provides the verification value
OPENAI_APPS_CHALLENGE=

# HTTP timeout configuration
REQUEST_TIMEOUT_MS=120000
HEADERS_TIMEOUT_MS=65000
KEEP_ALIVE_TIMEOUT_MS=60000