# Runtime
NODE_ENV=production
PORT=8787

# OpenAI domain-verification token
# OpenAI provides this during app submission.
OPENAI_APPS_CHALLENGE=

# Reverse proxy
#
# Leave blank during local development.
# Set only after AAUP confirms its proxy layout.
#
# Examples:
# TRUST_PROXY=1
# TRUST_PROXY=loopback
# TRUST_PROXY=127.0.0.1
# TRUST_PROXY=loopback,10.0.0.0/8
TRUST_PROXY=

# HTTP timeouts
REQUEST_TIMEOUT_MS=120000
HEADERS_TIMEOUT_MS=65000
KEEP_ALIVE_TIMEOUT_MS=60000